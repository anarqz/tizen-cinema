# Optional. Everything here can also be set in the TV app (Settings) or at http://<host>:3817/settings,
# which store values in data/config.json (those win over these variables).

# Jellyfin (the TV streams from it directly)
JELLYFIN_URL=http://192.168.1.10:8096

# Discovery (TMDB is required; Trakt and OMDb are recommended)
TMDB_TOKEN=
TRAKT_CLIENT_ID=
OMDB_API_KEY=

# Library management
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=
SONARR_QUALITY_PROFILE=
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=
RADARR_QUALITY_PROFILE=
PROWLARR_URL=http://192.168.1.10:9696
PROWLARR_API_KEY=
BAZARR_URL=http://192.168.1.10:6767
BAZARR_API_KEY=
DELUGE_URL=http://192.168.1.10:8112
DELUGE_PASSWORD=

# Metadata language (TMDB) and region (age ratings)
METADATA_LANGUAGE=en-US
REGION=US

# Optional PIN required to change settings
SETTINGS_PIN=
